# AeroCast backend — copy to .env and fill in what you need.
#   cp .env.example .env
# app.py loads .env automatically when python-dotenv is installed
# (pip install python-dotenv); otherwise export these in your shell.

# ---------------------------------------------------------------------------
# Chatbot — GroqCloud (required for LLM replies in the chat widget)
# ---------------------------------------------------------------------------
# Free key: https://console.groq.com/keys
# Without it /api/chat still answers, using grounded rule-based replies built
# from the live dashboard context.
GROQ_API_KEY=

# GroqCloud host. The groq client appends /openai/v1 itself, so this is the bare
# origin — only change it for a Groq-compatible proxy or gateway.
GROQ_BASE_URL=https://api.groq.com

# gpt-oss-120b is a reasoning model; the scratchpad is hidden and never streamed
# to the widget. Effort: low | medium | high.
AQI_CHAT_MODEL=openai/gpt-oss-120b
AQI_CHAT_REASONING_EFFORT=low
AQI_CHAT_MAX_TOKENS=800

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8000
FLASK_DEBUG=0
# AQI_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Models (../models/model_6|12|18|24.pkl)
# ---------------------------------------------------------------------------
AQI_MODEL_DIR=./models
AQI_USE_MODELS=1        # 0 = skip the ~890MB of pickles, use Open-Meteo forecasts
AQI_WARM_MODELS=1       # 0 = load lazily on first request instead of at boot
AQI_TREE_SAMPLE=150     # trees polled per prediction for the confidence band

# ---------------------------------------------------------------------------
# Live data
# ---------------------------------------------------------------------------
# Optional free token adds real ground stations to the heatmap:
# https://aqicn.org/data-platform/token/
WAQI_TOKEN=

# AQI_CACHE_TTL=600       # seconds a city's forecast stays cached
# AQI_ZONES_TTL=86400     # seconds OSM risk zones stay cached
# AQI_SAMPLE_SPAN=0.9     # degrees of the air-quality probe box
# AQI_USE_OVERPASS=1      # 0 = placeholder risk zones, no OpenStreetMap lookup
# AQI_OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass.osm.ch/api/interpreter
