# Copy to .env.local. Every value here has a working default.

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# Where the Flask backend (../backend/app.py) is listening. Next rewrites
# /api/* to this origin — see next.config.mjs. Server-side only, no restart-free
# reload: changing it requires restarting `next dev`.
BACKEND_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Basemap (optional — both have working keyless defaults)
# ---------------------------------------------------------------------------
# Default is Esri Dark Gray Canvas: no API key, dark enough that the AQI heatmap
# stays readable on top of it. Set both variables together when swapping.
# NEXT_PUBLIC_MAP_TILE_URL=https://services.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=Tiles &copy; Esri &mdash; Esri, HERE, Garmin, &copy; OpenStreetMap contributors

# CARTO Voyager — the previous default. Unkeyed requests now come back with
# "API KEY REQUIRED" stamped across every tile, so add your key from
# https://carto.com/ (see their basemap docs for the exact query parameter).
# NEXT_PUBLIC_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors &copy; CARTO

# Plain OpenStreetMap — keyless, but a light style under a heatmap.
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
